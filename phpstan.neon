includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes

    # Baseline level for a large existing codebase; raise toward 8 over time.
    level: 5

    # PR CI analyses only changed files; some ignore patterns will not match.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Laravel helpers accept truthy models; PHPStan wants a bool.
        - '#Parameter \#1 \$boolean of function abort_unless expects bool#'
        - '#Parameter \#1 \$boolean of function abort_if expects bool#'
        # Collection::first() is typed non-null in some stubs; nullsafe remains correct at runtime.
        - '#Using nullsafe property access#'

    excludePaths:
        - bootstrap/cache/*
        - database/migrations/*
        - database/seeders/*

    treatPhpDocTypesAsCertain: false
