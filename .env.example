APP_NAME="VoxSign"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Kampala

# Production checklist (server .env — never commit):
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# LOG_STACK=daily
# APP_URL=https://pearledu.voxsign.co.ug
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.voxsign.co.ug
# QUEUE_CONNECTION=database  (+ cron: * * * * * php artisan schedule:run)
# PLATFORM_ADMIN_PASSWORD=<strong unique password>
# SEED_DEMO_TENANT=false
# TENANCY_BASE_DOMAIN=voxsign.co.ug
# TENANCY_LANDING_HOSTS=voxsign.co.ug,www.voxsign.co.ug
# TENANCY_PEARLEDU_LANDING_HOST=pearledu.voxsign.co.ug
# MAIL_PASSWORD=<resend smtp password>
# Then: php artisan app:production-check
# Full guide: docs/PRODUCTION_CHECKLIST.md

TENANCY_BASE_DOMAIN=voxsign.test
TENANCY_LANDING_HOSTS=voxsign.test,www.voxsign.test
TENANCY_PEARLEDU_LANDING_HOST=pearledu.voxsign.test
TENANCY_TENANT_PREFIX=pearledu

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL — DB_USERNAME MUST be a NON-superuser role (superusers bypass RLS).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=voxsign
DB_USERNAME=voxsign_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_DOMAIN=.voxsign.test
# Idle logout (minutes). Default 30 — change with SESSION_LIFETIME.
SESSION_LIFETIME=30
# Production: SESSION_SECURE_COOKIE=true and SESSION_SAME_SITE=lax (or strict)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email via Resend (SMTP; verify the sending domain in Resend first)
# Laravel 13 uses MAIL_SCHEME (smtps for port 465), not MAIL_ENCRYPTION.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@voxsign.co.ug"
MAIL_FROM_NAME="VoxSign"
CONTACT_INBOX="hello@voxsign.co.ug"

# Platform admin (required — PlatformSeeder refuses to run without a strong password)
PLATFORM_ADMIN_NAME="Platform Admin"
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD=

# Optional local tenant scaffold (no shared login passwords are published)
SEED_DEMO_TENANT=false

# Optional Cloudflare Turnstile (contact, onboard, public /apply). Leave blank to skip.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# SMS: fake (default, no delivery) | log (log-only) | twilio (real delivery) | any other value fails closed until wired
SMS_DRIVER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SchoolPay (https://schoolpay.co.ug) — per-school code + API password are set in School identity.
# Base URL for Adhoc/Sync APIs. UAT: https://schoolpaytest.servicecops.com/uatpaymentapi
SCHOOLPAY_BASE_URL=https://schoolpay.co.ug/paymentapi
SCHOOLPAY_TIMEOUT=20
SCHOOLPAY_ADHOC_ENABLED=true
SCHOOLPAY_SYNC_LOOKBACK_DAYS=2
