APP_NAME="VoxSign"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pearledu.voxsign.co.ug
APP_TIMEZONE=Africa/Kampala

TENANCY_BASE_DOMAIN=voxsign.co.ug
TENANCY_LANDING_HOSTS=voxsign.co.ug,www.voxsign.co.ug
TENANCY_TENANT_PREFIX=pearledu

LOG_CHANNEL=stack
LOG_LEVEL=error

# PostgreSQL — DB_USERNAME MUST be a NON-superuser role (superusers bypass RLS).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=voxsign
DB_USERNAME=voxsign_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_DOMAIN=.voxsign.co.ug
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email via Resend (SMTP; verify the sending domain in Resend first)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@voxsign.co.ug"
MAIL_FROM_NAME="VoxSign"
CONTACT_INBOX="hello@voxsign.co.ug"

# SMS (platform-controlled reselling; 'fake' until a real provider is wired)
SMS_DRIVER=fake
