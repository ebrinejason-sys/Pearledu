APP_NAME="VoxSign"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Kampala

TENANCY_BASE_DOMAIN=voxsign.test
TENANCY_LANDING_HOSTS=voxsign.test,www.voxsign.test
TENANCY_TENANT_PREFIX=pearledu

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL — DB_USERNAME MUST be a NON-superuser role (superusers bypass RLS).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=voxsign
DB_USERNAME=voxsign_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_DOMAIN=.voxsign.test
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email via Resend (SMTP; verify the sending domain in Resend first)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@voxsign.co.ug"
MAIL_FROM_NAME="VoxSign"
CONTACT_INBOX="hello@voxsign.co.ug"

# Platform admin (required — PlatformSeeder refuses to run without a strong password)
PLATFORM_ADMIN_NAME="Ebrine Tushabe"
PLATFORM_ADMIN_EMAIL="ebrinetushabe@gmail.com"
PLATFORM_ADMIN_PASSWORD=

# Optional local tenant scaffold (no shared login passwords are published)
SEED_DEMO_TENANT=false

# Optional Cloudflare Turnstile (contact + onboard forms). Leave blank to skip.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# SMS: fake (default, no delivery) | log (log-only) | any other value fails closed until wired
SMS_DRIVER=fake
